# Copy to .env and fill in real values. Never commit .env.
# The Master Secret belongs only in this server-side file.

# Required for administrative dashboard and API calls.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

PORT=3000
DATABASE_URL=./data/engage.sqlite
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# EngageLab AppPush REST API.
# Use the Service Endpoint shown in the console (App Information).
# Do not choose a data center from the developer's physical location.
# Official base URLs:
#   Singapore          https://pushapi-sgp.engagelab.com
#   Virginia, USA      https://pushapi-usva.engagelab.com
#   Frankfurt, Germany https://pushapi-defra.engagelab.com
#   Hong Kong, China   https://pushapi-hk.engagelab.com
#   Japan              https://pushapi-jpn.engagelab.com
#   Brazil             https://pushapi-bra.engagelab.com
ENGAGELAB_APPKEY=
ENGAGELAB_MASTER_SECRET=
ENGAGELAB_BASE_URL=
ENGAGELAB_TIMEOUT_MS=15000

# IANA timezone of the EngageLab main site (zone_type=1).
# Singapore data center -> Asia/Singapore. Leave empty until the console endpoint is confirmed.
ENGAGELAB_SITE_TIMEZONE=

# Must match the Android applicationId and the console integration package name.
ANDROID_PACKAGE_NAME=com.example.engagevideopush

# Pixabay Video API. The key stays on this server and is never sent to Android.
# Leave it empty to keep the bundled sample catalogue. https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# auto: live when all three EngageLab values are set, otherwise labeled demo mode.
# true: demo mode, but startup fails if credentials are partially set.
# false: require complete EngageLab credentials.
DEMO_MODE=auto
